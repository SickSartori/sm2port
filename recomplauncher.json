{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "sm2port",
  "game": {
    "kind": "iso",
    "label": "Your disc image (.iso) of Spider-Man 2 for the Xbox: the Italian release, the European one (French, German, Spanish) or the World one.",
    "check": {
      "xdvdfs": "default.xbe"
    },
    "dumps": [
      { "name": "Spider-Man 2 (World)", "size": 7825162240, "crc32": "dd4a9f08" },
      { "name": "Spider-Man 2 (Europe) (Fr,De,Es)", "size": 7825162240, "crc32": "6273b0b9" },
      { "name": "Spider-Man 2 (Italy)", "size": 7825162240, "crc32": "0d0c5557" }
    ]
  },
  "start": {
    "program": [
      "sm2.exe"
    ],
    "args": [
      "{game}"
    ]
  },
  "saves": [
    "{install}/xbox_hdd"
  ],
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/sm2port.ini" }
      ],
      "game_path": "disc_image"
    }
  ],
  "settings": [
    {
      "id": "window",
      "label": "Window",
      "help": "Full screen (without a border, so Alt+Tab is instant) or a window. Big Picture mode always starts full screen.",
      "choices": [
        { "label": "Windowed", "set": { "fullscreen": "0" } },
        { "label": "Fullscreen", "set": { "fullscreen": "1" } }
      ],
      "defaults": { "fullscreen": "0" }
    },
    {
      "id": "language",
      "label": "Language",
      "help": "The game's language. Automatic follows Windows.",
      "choices": [
        { "label": "Automatic", "set": { "game_language": "0" } },
        { "label": "English", "set": { "game_language": "1" } },
        { "label": "Deutsch", "set": { "game_language": "3" } },
        { "label": "Français", "set": { "game_language": "4" } },
        { "label": "Español", "set": { "game_language": "5" } },
        { "label": "Italiano", "set": { "game_language": "6" } }
      ],
      "defaults": { "game_language": "0" }
    },
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "30 is the Xbox's own; 60 is smoother and needs a PC that handles twice the work; 120 needs a fast processor and a screen of 120 Hz or more.",
      "choices": [
        { "label": "30 fps", "set": { "frame_rate": "30" } },
        { "label": "60 fps", "set": { "frame_rate": "60" } },
        { "label": "120 fps", "set": { "frame_rate": "120" } }
      ],
      "defaults": { "frame_rate": "30" }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "What the game draws at: higher is smoother and costs more.",
      "choices": [
        {
          "label": "Like the screen",
          "set": {
            "render_scale": "0"
          }
        },
        {
          "label": "480p (Xbox)",
          "set": {
            "render_scale": "1"
          }
        },
        {
          "label": "720p",
          "set": {
            "render_scale": "1.5"
          }
        },
        {
          "label": "1080p",
          "set": {
            "render_scale": "2.25"
          }
        },
        {
          "label": "1440p",
          "set": {
            "render_scale": "3"
          }
        },
        {
          "label": "4K",
          "set": {
            "render_scale": "4.5"
          }
        }
      ],
      "defaults": {
        "render_scale": "0"
      }
    },
    {
      "id": "picture",
      "label": "Picture",
      "help": "The game's own widescreen mode (wider view, no black bars); 21:9 takes the shape of a screen wider than 16:9 (films stay 16:9); or 4:3 like a classic TV.",
      "choices": [
        {
          "label": "16:9",
          "set": {
            "widescreen": "1"
          }
        },
        {
          "label": "21:9",
          "set": {
            "widescreen": "2"
          }
        },
        {
          "label": "4:3",
          "set": {
            "widescreen": "0"
          }
        }
      ],
      "defaults": {
        "widescreen": "1"
      }
    },
    {
      "id": "field_of_view",
      "label": "Field of view",
      "help": "How wide the camera sees: 100% is the game's own.",
      "choices": [
        {
          "label": "75%",
          "set": {
            "field_of_view": "75"
          }
        },
        {
          "label": "90%",
          "set": {
            "field_of_view": "90"
          }
        },
        {
          "label": "100%",
          "set": {
            "field_of_view": "100"
          }
        },
        {
          "label": "115%",
          "set": {
            "field_of_view": "115"
          }
        },
        {
          "label": "130%",
          "set": {
            "field_of_view": "130"
          }
        }
      ],
      "defaults": {
        "field_of_view": "100"
      }
    },
    {
      "id": "draw_distance",
      "label": "Draw distance",
      "help": "How far away cars, pedestrians and detailed buildings are drawn: 100% is the game's own. More costs frames.",
      "choices": [
        {
          "label": "100%",
          "set": {
            "draw_distance": "100"
          }
        },
        {
          "label": "150%",
          "set": {
            "draw_distance": "150"
          }
        },
        {
          "label": "200%",
          "set": {
            "draw_distance": "200"
          }
        },
        {
          "label": "300%",
          "set": {
            "draw_distance": "300"
          }
        }
      ],
      "defaults": {
        "draw_distance": "100"
      }
    },
    {
      "id": "texture_filter",
      "label": "Texture filter",
      "help": "Anisotropic filtering: streets and walls stay sharp at a slant. 16x costs little on any graphics card.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "anisotropy": "1"
          }
        },
        {
          "label": "4x",
          "set": {
            "anisotropy": "4"
          }
        },
        {
          "label": "8x",
          "set": {
            "anisotropy": "8"
          }
        },
        {
          "label": "16x",
          "set": {
            "anisotropy": "16"
          }
        }
      ],
      "defaults": {
        "anisotropy": "16"
      }
    },
    {
      "id": "sharp_textures",
      "label": "Sharp textures",
      "help": "The textures of streets, buildings and people enlarged with their edges kept, for when you see them from close. They take more graphics memory and sharpen a few seconds after a place loads.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "sharp_textures": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "sharp_textures": "1"
          }
        }
      ],
      "defaults": {
        "sharp_textures": "0"
      }
    },
    {
      "id": "modern_effects",
      "label": "Modern effects",
      "help": "Glow, sharpening, colour, vignette and ambient occlusion; F10 switches them while playing.",
      "choices": [
        {
          "label": "On",
          "set": {
            "effects": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "effects": "0"
          }
        }
      ],
      "defaults": {
        "effects": "1"
      }
    },
    {
      "id": "frame_counter",
      "label": "Frame counter",
      "help": "Frames per second in a corner while playing.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fps_counter": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fps_counter": "1"
          }
        }
      ],
      "defaults": {
        "fps_counter": "0"
      }
    },
    {
      "id": "mouse_look",
      "label": "Mouse camera",
      "help": "With the keyboard, the mouse moves the camera. Off: the arrow keys only.",
      "choices": [
        {
          "label": "On",
          "set": {
            "mouse_look": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "mouse_look": "0"
          }
        }
      ],
      "defaults": {
        "mouse_look": "1"
      }
    },
    {
      "id": "volume",
      "label": "Volume",
      "help": "Overall volume; 100 is the loudest.",
      "choices": [
        {
          "label": "100",
          "set": {
            "volume": "100"
          }
        },
        {
          "label": "75",
          "set": {
            "volume": "75"
          }
        },
        {
          "label": "50",
          "set": {
            "volume": "50"
          }
        },
        {
          "label": "25",
          "set": {
            "volume": "25"
          }
        }
      ],
      "defaults": {
        "volume": "100"
      }
    }
  ],
  "folders": {
    "saves": [
      { "path": "{install}/xbox_hdd" }
    ],
    "logs": [
      { "path": "{install}/logs" }
    ]
  },
  "exit_codes": {
    "2": "sm2port could not use your disc image: it is missing, incomplete, or another version or region. It needs the Italian, the European (French, German, Spanish) or the World release of Spider-Man 2 for the Xbox, as a complete .iso: pick it again on the game's page.",
    "3": "sm2port could not start Direct3D 11, which it needs to draw the game. Update the graphics driver; on Linux, install the 32-bit Vulkan and OpenGL libraries (see the README, Linux)."
  }
}
