{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "sm2port",
  "game": {
    "kind": "iso",
    "label": "Your disc image (.iso) of Spider-Man 2 for the Xbox: the Italian release, or the European one (French, German, Spanish).",
    "check": { "xdvdfs": "default.xbe" }
  },
  "start": {
    "program": ["sm2.exe"],
    "args": ["{game}"]
  },
  "saves": ["{install}/xbox_hdd"],
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": "{install}/sm2port.ini",
      "game_path": "disc_image"
    }
  ],
  "settings": [
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "30 is the Xbox's own; 60 is smoother but still experimental and needs a PC that handles twice the work.",
      "choices": [
        { "label": "30 fps", "set": { "frame_rate": "30" } },
        { "label": "60 fps (experimental)", "set": { "frame_rate": "60" } }
      ],
      "defaults": { "frame_rate": "30" }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "What the game draws at: higher is smoother and costs more.",
      "choices": [
        { "label": "Like the screen", "set": { "render_scale": "0" } },
        { "label": "480p (Xbox)", "set": { "render_scale": "1" } },
        { "label": "720p", "set": { "render_scale": "1.5" } },
        { "label": "1080p", "set": { "render_scale": "2.25" } },
        { "label": "1440p", "set": { "render_scale": "3" } },
        { "label": "4K", "set": { "render_scale": "4.5" } }
      ],
      "defaults": { "render_scale": "0" }
    },
    {
      "id": "picture",
      "label": "Picture",
      "help": "The game's own widescreen mode (wider view, no black bars), or 4:3 like a classic TV.",
      "choices": [
        { "label": "16:9", "set": { "widescreen": "1" } },
        { "label": "4:3", "set": { "widescreen": "0" } }
      ],
      "defaults": { "widescreen": "1" }
    },
    {
      "id": "mouse_look",
      "label": "Mouse camera",
      "help": "With the keyboard, the mouse moves the camera. Off: the arrow keys only.",
      "choices": [
        { "label": "On", "set": { "mouse_look": "1" } },
        { "label": "Off", "set": { "mouse_look": "0" } }
      ],
      "defaults": { "mouse_look": "1" }
    },
    {
      "id": "volume",
      "label": "Volume",
      "help": "Overall volume; 100 is the loudest.",
      "choices": [
        { "label": "100", "set": { "volume": "100" } },
        { "label": "75", "set": { "volume": "75" } },
        { "label": "50", "set": { "volume": "50" } },
        { "label": "25", "set": { "volume": "25" } }
      ],
      "defaults": { "volume": "100" }
    }
  ],
  "folders": {
    "saves": "{install}/xbox_hdd",
    "logs": "{install}/logs"
  },
  "exit_codes": {
    "2": "sm2port could not use your disc image. It needs the Italian or the European (French, German, Spanish) release of Spider-Man 2 for the Xbox, as a complete .iso: pick it again on the game's page."
  }
}
